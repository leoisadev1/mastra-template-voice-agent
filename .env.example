# --- Required ---

# LiveKit Cloud credentials. Create a free project at https://cloud.livekit.io, then Settings -> API Keys.
# The free tier includes inference credit, so the Deepgram STT and Cartesia TTS model strings work
# through LiveKit Inference without separate Deepgram or Cartesia accounts.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI API key. Used by the agent model (openai/gpt-5-mini), the memory observer, and the recall embedder.
OPENAI_API_KEY=

# --- Optional ---

# Absolute path for the shared LibSQL database file (memory, threads, traces, vector index).
# On Railway set VOICE_AGENT_DB_PATH=/data/voice-agent.db with a volume mounted at /data.
# Local default: ./voice-agent.db at the project root.
# VOICE_AGENT_DB_PATH=

# Mastra server port. Default 4111.
# PORT=4111

# Where the plugin worker (`pnpm worker:plugin`) reaches the Mastra server. Default http://localhost:4111.
# MASTRA_URL=http://localhost:4111

# Hugging Face cache directory for the turn-detection model download.
# On Railway set HF_HOME=/app/.cache/huggingface so the build-time download persists into the runtime image.
# HF_HOME=
